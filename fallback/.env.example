# fallback/.env.example - names only. Never commit real values.
#
# Deployed endpoint (copy the URL `modal deploy` prints, keep the /v1/chat/completions path):
#   https://<workspace>--linecheck-fallback-serve.modal.run/v1/chat/completions
META_OPEN_WEIGHTS_SPARK_URL=
META_OPEN_WEIGHTS_MODEL=llama-3.2-11b-vision

# Bearer token the proxy sends. Must equal FALLBACK_API_KEY in the Modal secret `linecheck-fallback`.
MODAL_API_KEY=

# auto = fail over from primary to the open-weight tier on the triggers below; off = never.
FALLBACK_MODE=off
FALLBACK_TIER=open-weights
FALLBACK_TRIGGERS=status,timeout,network
FALLBACK_COOLDOWN_MS=60000

# vLLM speaks OpenAI, so the Spark adapter must too.
PROXY_SPARK_PROTOCOL=openai

# Llama 3.2 Vision has no OpenAI tool_calls in vLLM; parse the JSON it is asked to emit instead.
PROXY_FALLBACK_TOOL_JSON=true

# The fallback is cheaper than the primary in practice; set the real number once Modal reports usage.
COST_PER_OPEN_WEIGHTS_CALL_USD=0.01
