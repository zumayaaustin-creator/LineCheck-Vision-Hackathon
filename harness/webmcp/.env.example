# ---- Meta integration flags ----------------------------------------------
# Mock-first by DEFAULT: SAM 3.1 / Muse live calls are only made when this is
# explicitly "false" AND a key + endpoint are present. Leave it unset while
# developing the HUD so reticle/voice tests never spend credits.
VITE_USE_MOCK_META=true

# PROXY MODE (recommended): point the app at harness/proxy-server.mjs, which holds the
# real key server-side. The browser then needs NO credential at all.
#   VITE_USE_PROXY=true
#   VITE_SAM_MODEL_ENDPOINT=http://127.0.0.1:8790/sam-3.1/segment
#   VITE_MUSE_AUDIO_ENDPOINT=http://127.0.0.1:8790/muse-audio/transcribe
VITE_USE_PROXY=false

# Direct mode only. DANGER: every VITE_* value is inlined into the browser bundle, so
# anything here is public. Use proxy mode for anything real. Never commit the real .env.
VITE_META_API_KEY=
VITE_SAM_MODEL_ENDPOINT=
VITE_MUSE_AUDIO_ENDPOINT=

# ---- Throttling ----------------------------------------------------------
# Hard floor between paid SAM 3.1 calls (ms). Client refuses faster than this,
# regardless of how often the UI asks.
VITE_SNAPSHOT_MIN_INTERVAL_MS=1500

# ---- Source frame geometry ----------------------------------------------
# Pixel space the live model returns boxes in. Detections are normalised from
# this into the fixed 600x600 HUD canvas before they reach hud/state.ts.
VITE_SOURCE_FRAME_WIDTH=1280
VITE_SOURCE_FRAME_HEIGHT=720
